      "type": "react-component",
      "path": "ontology-technique-eval/assets/FormatIntroduction.tsx",
      "description": "Part C reflection on description formats and ontology tags.",
      "withSidebar": false,
      "nextButtonLocation": "belowStimulus",
      "previousButton": true,
      "parameters": {
        "variant": "recall"
      },
      "response": [
        {
          "id": "partCIntro",
          "type": "textOnly",
          "location": "belowStimulus",
          "prompt": "These sample cards are here to remind you of the two description formats. The questions below refer to that structure. There are no right or wrong answers.",
          "restartEnumeration": true
        },
        {
          "id": "ontologyCategoryRank",
          "prompt": "The ontology tags are grouped into four categories: Modality; Forensic Goal & Task; Search & Analysis Scope; Evidentiary Features. Please rank them from the most useful to least useful when you use them for making decisions.",
          "location": "belowStimulus",
          "type": "custom",
          "path": "ontology-technique-eval/assets/OntologyCategoryRanking.tsx",
          "required": false,
          "parameters": {
            "options": [
              "Modality",
              "Forensic Goal & Task",
              "Search & Analysis Scope",
              "Evidentiary Features"
            ]
          }
        },
        {
          "id": "formatPreference",
          "prompt": "If you were to work through more scenarios like what you just did, which would you rather have alongside each technique description?",
          "location": "belowStimulus",
          "type": "radio",
          "options": [
            {
              "label": "1 - Strongly prefer the paper's keywords",
              "value": "1"
            },
            {
              "label": "2 - Somewhat prefer the paper's keywords",
              "value": "2"
            },
            {
              "label": "3 - No preference",
              "value": "3"
            },
            {
              "label": "4 - Somewhat prefer the ontology tags",
              "value": "4"
            },
            {
              "label": "5 - Strongly prefer the ontology tags",
              "value": "5"
            }
          ],
          "required": false
        },
        {
          "id": "formatPreferenceWhy",
          "prompt": "Why?",
          "location": "belowStimulus",
          "type": "longText",
          "placeholder": "A sentence or two is enough.",
          "required": false
        },
        {
          "id": "hoverDefinitionUsefulness",
          "prompt": "When ontology tags were shown, how useful were the hover definitions (the text that appears when you hover a tag or the info icon)?",
          "location": "belowStimulus",
          "type": "radio",
          "required": false,
          "options": [
            {
              "label": "1 — Not at all useful",
              "value": "1"
            },
            {
              "label": "2 — Slightly useful",
              "value": "2"
            },
            {
              "label": "3 — Moderately useful",
              "value": "3"
            },
            {
              "label": "4 — Very useful",
              "value": "4"
            },
            {
              "label": "5 — Extremely useful",
              "value": "5"
            },
            {
              "label": "I did not hover any tags or info icons",
              "value": "didNotHover"
            }
          ]
        },
        {
          "id": "hoverDefinitionNote",
          "prompt": "If a definition was confusing or a tag felt mislabeled, which one, and what was wrong?",
          "location": "belowStimulus",
          "type": "longText",
          "placeholder": "Optional. Skip if nothing stood out.",
          "required": false
        },
        {
          "id": "ontologyReflections",
          "prompt": "Anything else about the ontology tags — how useful they were, what was missing, or how they compared with keywords — that you want to tell us?",
          "location": "belowStimulus",
          "type": "longText",
          "placeholder": "Optional. A sentence or two is enough.",
